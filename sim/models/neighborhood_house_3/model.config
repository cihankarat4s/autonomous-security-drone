<?xml version="1.0"?>
<model>
  <name>neighborhood_house_3</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Gazebo Fuel "House 3" (OpenRobotics) with its texture as a PBR material.
    The Fuel model uses an Ogre 1 material script, which Gazebo Harmonic's
    Ogre 2 renderer ignores, so the house rendered black.
  </description>
</model>
