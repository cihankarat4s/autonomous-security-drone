<?xml version="1.0" ?>
<!-- 160 x 200 m textured ground (x -80..80, y -90..110) on a larger plain
     grass plane. Matches the area in sim/make_ground_texture.py. -->
<sdf version="1.9">
  <model name="urban_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane><normal>0 0 1</normal><size>400 400</size></plane>
        </geometry>
      </collision>
      <visual name="surround">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane><normal>0 0 1</normal><size>400 400</size></plane>
        </geometry>
        <material>
          <ambient>0.33 0.45 0.24 1</ambient>
          <diffuse>0.33 0.45 0.24 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <visual name="textured">
        <pose>0 10 0.01 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane><normal>0 0 1</normal><size>160 200</size></plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://urban_ground/materials/textures/ground.jpg</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
