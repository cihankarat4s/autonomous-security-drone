<?xml version="1.0" ?>
<!--
  Orthophoto security patrol world: same home, drone, plugins and protected
  area (60 m north of home) as security_patrol.sdf, on a real drone
  orthophoto instead of a generated texture: a parking lot (home) and a park
  (protected area) in Split, Croatia (OpenAerialMap, CC-BY 4.0, WebODM /
  om1s186, 2022; texture made by sim/make_ortho_ground.py).

  The photo already has the parked cars, buildings, trees and paths, so the
  only 3D models are the people: three standing in the protected area and one
  walking an 8 m square around its centre. No people are in the photo itself.

  Frame: +X = east, +Y = north. World name stays "security_patrol" so the
  camera topic in config/default.yaml is unchanged.
-->
<sdf version="1.9">
  <world name="security_patrol">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6</ambient>
      <background>0.6 0.75 0.9</background>
      <sky></sky>
    </scene>

    <!-- Same home as iris_runway, so SITL's home matches. -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <!-- Matches the photo: its shadows fall east, a little north. -->
      <direction>0.7 0.18 -0.7</direction>
    </light>

    <include><uri>model://ortho_ground</uri></include>

    <!-- People in the protected area (20 x 20 m around 0, 60). -->
    <include>
      <name>person_standing</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <pose>6 52 0 0 0 1.2</pose>
    </include>
    <include>
      <name>person_casual</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <pose>-7 66 0 0 0 -2.4</pose>
    </include>
    <include>
      <name>person_walking_static</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
      <pose>-6 50 0 0 0 0.4</pose>
    </include>

    <!-- Person walking an 8 m square (1 m/s) around the centre of the protected area. -->
    <actor name="intruder">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>-4 56 1.0 0 0 0</pose></waypoint>
          <waypoint><time>8</time><pose>4 56 1.0 0 0 0</pose></waypoint>
          <waypoint><time>9</time><pose>4 56 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>17</time><pose>4 64 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>18</time><pose>4 64 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>26</time><pose>-4 64 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>27</time><pose>-4 64 1.0 0 0 4.7124</pose></waypoint>
          <waypoint><time>35</time><pose>-4 56 1.0 0 0 4.7124</pose></waypoint>
          <waypoint><time>36</time><pose>-4 56 1.0 0 0 6.2832</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <include>
      <uri>model://iris_with_gimbal</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>

  </world>
</sdf>
