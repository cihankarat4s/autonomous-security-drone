<?xml version="1.0" ?>
<!--
  Urban security patrol world: same home, drone, plugins and protected area
  (60 m north of home) as security_patrol.sdf, on a textured ground with
  roads, trees, buildings, vehicles, street furniture and several people.

  Two zones keep the false-positive test honest:
    test zone (north, y > 35): the protected area with the walking intruder,
      three more people and person-like clutter (bench, bin, hydrant, cones,
      lamp posts, mailbox). The patrol mission flies here; hard negatives are
      never collected here.
    training zone (south, y < 0): other objects, no people. Hard negatives are
      collected here (sim/fly_negative_mission.py --zone urban).

  Frame: +X = east, +Y = north. World name stays "security_patrol" so the
  camera topic in config/default.yaml is unchanged. The ground texture comes
  from sim/make_ground_texture.py; Fuel models download on the first run.
-->
<sdf version="1.9">
  <world name="security_patrol">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6</ambient>
      <background>0.6 0.75 0.9</background>
      <sky></sky>
    </scene>

    <!-- Same home as iris_runway, so SITL's home matches. -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include><uri>model://urban_ground</uri></include>

    <!-- ===================== Test zone (north) ===================== -->

    <!-- People: three static figures inside / next to the protected area. -->
    <include>
      <name>person_standing</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <pose>6 52 0 0 0 1.2</pose>
    </include>
    <include>
      <name>person_casual</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <pose>-7 66 0 0 0 -2.4</pose>
    </include>
    <include>
      <name>person_walking_static</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Walking person</uri>
      <pose>-12 44 0 0 0 0.4</pose>
    </include>

    <!-- Person-like clutter around the plaza. -->
    <include>
      <name>bench_plaza</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FoodCourtBenchLong</uri>
      <pose>-12 58 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>bin_plaza</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TrashBin</uri>
      <pose>-12 63 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_plaza_sw</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <pose>-13 47 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_plaza_ne</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <pose>13 73 0 0 0 3.1416</pose>
    </include>
    <include>
      <name>hydrant_plaza</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire hydrant</uri>
      <pose>10.5 55 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_plaza_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <pose>7 69 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_plaza_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <pose>8 70.5 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_plaza_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <pose>9 69 0 0 0 0</pose>
    </include>
    <include>
      <name>mailbox_plaza</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mailbox</uri>
      <pose>10.3 77 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>dumpster_north</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dumpster</uri>
      <pose>-17 41 0 0 0 0.3</pose>
    </include>
    <include>
      <name>suv_north</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/SUV</uri>
      <pose>17.5 63 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>oak_north_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>-23 60 0 0 0 0</pose>
    </include>
    <include>
      <name>oak_north_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>-21 82 0 0 0 1.0</pose>
    </include>
    <include>
      <name>pine_north</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>27 48 0 0 0 0</pose>
    </include>
    <include>
      <name>house_north</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/House 2</uri>
      <pose>-38 76 0 0 0 0</pose>
    </include>

    <!-- Person walking an 8 m square (1 m/s) around the centre of the protected area. -->
    <actor name="intruder">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walking">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0</time><pose>-4 56 1.0 0 0 0</pose></waypoint>
          <waypoint><time>8</time><pose>4 56 1.0 0 0 0</pose></waypoint>
          <waypoint><time>9</time><pose>4 56 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>17</time><pose>4 64 1.0 0 0 1.5708</pose></waypoint>
          <waypoint><time>18</time><pose>4 64 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>26</time><pose>-4 64 1.0 0 0 3.1416</pose></waypoint>
          <waypoint><time>27</time><pose>-4 64 1.0 0 0 4.7124</pose></waypoint>
          <waypoint><time>35</time><pose>-4 56 1.0 0 0 4.7124</pose></waypoint>
          <waypoint><time>36</time><pose>-4 56 1.0 0 0 6.2832</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- ===================== Training zone (south), no people ===================== -->

    <include>
      <name>house_south_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/House 1</uri>
      <pose>-40 -8 0 0 0 0</pose>
    </include>
    <include>
      <name>house_south_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/House 3</uri>
      <pose>36 -45 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>bus_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bus</uri>
      <pose>17.5 -40 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>hatchback_lot</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback</uri>
      <pose>-52 -66 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>hatchback_red_lot</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback red</uri>
      <pose>-41 -48 0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>pickup_lot</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <pose>-57 -48 0 0 0 -1.5708</pose>
    </include>
    <include>
      <name>barrier_south_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-12 -30 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-7 -30 0 0 0 0</pose>
    </include>
    <include>
      <name>oak_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>-24 -45 0 0 0 0.5</pose>
    </include>
    <include>
      <name>pine_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>-30 -75 0 0 0 0</pose>
    </include>
    <include>
      <name>bench_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/FoodCourtBenchLong</uri>
      <pose>-8 -16 0 0 0 0</pose>
    </include>
    <include>
      <name>bin_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TrashBin</uri>
      <pose>-4 -16 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_south_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <pose>21 -30 0 0 0 3.1416</pose>
    </include>
    <include>
      <name>lamp_south_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Lamp Post</uri>
      <pose>-20 -18 0 0 0 0</pose>
    </include>
    <include>
      <name>hydrant_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Fire hydrant</uri>
      <pose>10.4 -12 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_south_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <pose>-22 -32 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_south_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <pose>-19 -33 0 0 0 0</pose>
    </include>
    <include>
      <name>mailbox_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Mailbox</uri>
      <pose>10.3 -55 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>dumpster_south</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Dumpster</uri>
      <pose>-63 -40 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://iris_with_gimbal</uri>
      <pose degrees="true">0 0 0.195 0 0 90</pose>
    </include>

  </world>
</sdf>
